[elasticsearch]
host: es.graphcert.cede-apps.ch
port: 9200
username: xxxx
password: xxxx
cafile: /path/to/your/es.crt
index: graphsearch_prod

[rcp]
base_url: https://inference.rcp.epfl.ch/v1
api_key: xxxx

[graphsearch]
base_url: https://graphsearch.epfl.ch

[graphai]
host: https://graphai.graphcert.cede-apps.ch
port: 443
username: xxxx
password: xxxx

[cache]
; Root dir for on-disk caches; each one appends its own subdirectory (e.g. image
; transcriptions land under <cache_dir>/image-transcriptions). Empty keeps it at
; <tempdir>/.cache/chatbot.
cache_dir:

[langfuse]
host: https://langfuse.cede-apps.ch
secret_key: xxxx
public_key: xxxx
environment: local

[moodle]
; The web-service account this app talks to Moodle through.
base_url: https://moodle.epfl.ch
token: xxxx
; Seconds to wait on a Moodle call before giving up.
timeout: 10

[moodle_polling]
; Seconds between polling passes.
interval_seconds: 30
